generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String?   @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  username                 String?   @unique
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String    @default("free")
  notifNewMessage          Boolean   @default(true)
  notifWeeklyReport        Boolean   @default(true)
  notifProductUpdates      Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  platforms                Platform[]
  profile                  Profile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Platform {
  id            String    @id @default(cuid())
  userId        String
  type          String
  platformId    String
  username      String
  displayName   String?
  avatarUrl     String?
  stats         Json?
  lastFetched   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  profileId   String
  company     String
  // Email de réponse du sponsor (optionnel : les anciens messages n'en ont pas)
  email       String?
  budget      String
  type        String
  message     String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  profileId String
  ip        String?
  country   String?
  userAgent String?  @db.Text
  referer   String?
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

// Idempotence des webhooks Stripe : on enregistre chaque event.id traité.
// Stripe redélivre les events (retries, livraison "at-least-once") — on ignore
// tout event déjà vu pour éviter de réactiver un abonnement annulé, etc.
model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  slug             String   @unique
  displayName      String?
  bio              String?
  niche            String?
  theme            String?
  formats          Json?
  showPartnerships Boolean  @default(true)
  partnerships     Json?
  bannerUrl        String?
  calendlyUrl      String?
  twitterHandle       String?
  instagramHandle     String?
  tiktokHandle        String?
  country             String?
  languages           Json?
  contentStyle        String?
  targetBrands        String?
  availableForCollabs Boolean  @default(true)
  positioningPhrase   String?
  sponsorSummary      String?
  isPublic            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         Message[]
  pageViews        PageView[]
}
