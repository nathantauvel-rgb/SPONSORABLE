generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String    @id @default(cuid())
  name                     String?
  email                    String?   @unique
  emailVerified            DateTime?
  image                    String?
  password                 String?
  username                 String?   @unique
  // Type de compte : 'creator' (par défaut, le cas historique) ou 'company'.
  // Un User est soit un créateur (a un Profile) soit une marque (a une Company).
  accountType              String    @default("creator")
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  stripeSubscriptionStatus String    @default("free")
  notifNewMessage          Boolean   @default(true)
  notifWeeklyReport        Boolean   @default(true)
  notifProductUpdates      Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  accounts                 Account[]
  sessions                 Session[]
  platforms                Platform[]
  profile                  Profile?
  // Marketplace
  company                  Company?
  favoritedBy              CompanyFavorite[] @relation("CreatorFavorites")
  conversations            Conversation[]    @relation("CreatorConversations")
  sentMessages             DirectMessage[]   @relation("MessageSender")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Platform {
  id            String    @id @default(cuid())
  userId        String
  type          String
  platformId    String
  username      String
  displayName   String?
  avatarUrl     String?
  stats         Json?
  lastFetched   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  profileId   String
  company     String
  // Email de réponse du sponsor (optionnel : les anciens messages n'en ont pas)
  email       String?
  budget      String
  type        String
  message     String   @db.Text
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  profileId String
  ip        String?
  country   String?
  userAgent String?  @db.Text
  referer   String?
  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
}

// Idempotence des webhooks Stripe : on enregistre chaque event.id traité.
// Stripe redélivre les events (retries, livraison "at-least-once") — on ignore
// tout event déjà vu pour éviter de réactiver un abonnement annulé, etc.
model StripeEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  slug             String   @unique
  displayName      String?
  bio              String?
  niche            String?
  theme            String?
  formats          Json?
  showPartnerships Boolean  @default(true)
  partnerships     Json?
  bannerUrl        String?
  calendlyUrl      String?
  twitterHandle       String?
  instagramHandle     String?
  tiktokHandle        String?
  country             String?
  languages           Json?
  contentStyle        String?
  targetBrands        String?
  availableForCollabs Boolean  @default(true)
  positioningPhrase   String?
  sponsorSummary      String?
  isPublic            Boolean  @default(true)
  // ─── Champs dénormalisés pour l'annuaire marketplace (filtre/tri SQL) ───
  // Recalculés par le cron + à chaque refresh stats / sauvegarde media kit
  // (cf. src/lib/profileDenormalize.ts). Le score réel reste calculé à la volée
  // par sponsorScore.ts ; ici on en cache la valeur pour pouvoir filtrer/trier.
  sponsorScore     Int?      // score de sponsorabilité caché (0–100), null si jamais calculé
  audienceTotal    Int?      // somme abonnés/followers toutes plateformes, pour le filtre taille
  games            String[]  // jeux structurés (renseignés via l'éditeur media kit), pour le filtre annuaire
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         Message[]
  pageViews        PageView[]

  @@index([sponsorScore])
  @@index([audienceTotal])
}

// ════════════════════════════════════════════════════════════════════════════
// Marketplace marque ↔ créateur — Phase 1 (profil marque + annuaire + messagerie)
// Les briefs/candidatures (Phase 2) ne sont PAS modélisés ici.
// ════════════════════════════════════════════════════════════════════════════

// Profil entreprise — en 1:1 avec un User dont accountType = 'company'.
model Company {
  id                   String   @id @default(cuid())
  userId               String   @unique
  name                 String
  sector               String?
  logoUrl              String?
  website              String?
  description          String?  @db.Text
  budgetMinEur         Int?     // budget indicatif par collaboration
  budgetMaxEur         Int?
  preferredGames       String[] // ex: ['valorant', 'lol', 'fortnite']
  preferredLanguages   String[] // ex: ['fr', 'en']
  targetAudienceAgeMin Int?
  targetAudienceAgeMax Int?
  isVerified           Boolean  @default(false) // vérification manuelle anti-fake marques
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites            CompanyFavorite[]
  conversations        Conversation[]

  @@index([sector])
}

// Favori marque -> créateur. creatorId = User.id du créateur.
model CompanyFavorite {
  companyId String
  creatorId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator   User     @relation("CreatorFavorites", fields: [creatorId], references: [id], onDelete: Cascade)

  @@id([companyId, creatorId])
  @@index([creatorId])
}

// Un fil de discussion entre une marque et un créateur.
// Phase 1 : contact direct uniquement (pas de briefId — ajouté en Phase 2).
model Conversation {
  id        String   @id @default(cuid())
  companyId String
  creatorId String   // User.id du créateur
  status    String   @default("open") // 'open' | 'archived'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator   User     @relation("CreatorConversations", fields: [creatorId], references: [id], onDelete: Cascade)
  messages  DirectMessage[]

  @@unique([companyId, creatorId])
  @@index([creatorId])
}

// Message interne. senderId = User.id (marque ou créateur — tous deux sont des Users).
// Nommé DirectMessage pour ne pas entrer en collision avec le model Message existant
// (formulaire de contact sponsor sur la page publique).
model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String       // User.id de l'expéditeur
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}
